local Utils = {}

function Utils.safeCall(fn, ...)
    local args = {...}
    local ok, result = pcall(function()
        return fn(table.unpack(args))
    end)
    if not ok then
        State.Stats.Errors = State.Stats.Errors + 1
        warn("[PartControl] " .. tostring(result))
    end
    return ok, result
end

function Utils.round(num, decimals)
    local mult = 10 ^ (decimals or 0)
    return math.floor(num * mult + 0.5) / mult
end

function Utils.formatTime(seconds)
    local mins = math.floor(seconds / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d", mins, secs)
end

function Utils.getCharacter()
    return LocalPlayer.Character
end

function Utils.getRootPart()
    local char = Utils.getCharacter()
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

function Utils.getHumanoid()
    local char = Utils.getCharacter()
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

function Utils.isAlive()
    local hum = Utils.getHumanoid()
    if not hum then return false end
    return hum.Health > 0
end

function Utils.distance(a, b)
    if not a or not b then return math.huge end
    return (a.Position - b.Position).Magnitude
end

function Utils.isPartValid(part)
    if not part then return false end
    if not part:IsA("BasePart") then return false end
    if not part.Parent then return false end
    if part.Anchored then return false end
    return true
end

function Utils.isPartOfCharacter(part)
    if not part then return false end
    local char = Utils.getCharacter()
    if not char then return false end
    return part:IsDescendantOf(char)
end

function Utils.findNearestPart()
    local root = Utils.getRootPart()
    if not root then return nil end
    local nearest = nil
    local nearestDist = CONFIG.AUTO_CATCH_RADIUS
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj.Anchored and not Utils.isPartOfCharacter(obj) then
            local d = Utils.distance(root, obj)
            if d < nearestDist then
                nearestDist = d
                nearest = obj
            end
        end
    end
    return nearest
end

function Utils.getOwnerName(part)
    if not part then return "—" end
    local ok, owner = pcall(function()
        return part:GetNetworkOwner()
    end)
    if ok and owner then
        return owner.Name
    end
    return "Сервер / Неизвестно"
end

function Utils.findPlayerWhoOwns(part)
    if not part then return nil end
    local ok, owner = pcall(function()
        return part:GetNetworkOwner()
    end)
    if ok and owner then
        return owner
    end
    return nil
end

local Logger = {}

function Logger.add(message, level)
    level = level or "INFO"
    local timestamp = os.date("%H:%M:%S")
    local entry = string.format("[%s] [%s] %s", timestamp, level, message)
    table.insert(State.Log, entry)
    if #State.Log > CONFIG.LOG_MAX_LINES then
        table.remove(State.Log, 1)
    end
    print(entry)
    if State.Gui and State.Gui.LogLabel then
        State.Gui.LogLabel.Text = table.concat(State.Log, "\n")
    end
end

function Logger.info(msg) Logger.add(msg, "INFO") end
function Logger.warn(msg) Logger.add(msg, "WARN") end
function Logger.error(msg) Logger.add(msg, "ERROR") end
function Logger.success(msg) Logger.add(msg, "OK") end

local History = {}

function History.add(part)
    if not part then return end
    for i, v in ipairs(State.History) do
        if v == part then
            table.remove(State.History, i)
            break
        end
    end
    table.insert(State.History, 1, part)
    while #State.History > CONFIG.MAX_HISTORY do
        table.remove(State.History)
    end
end

function History.clear()
    State.History = {}
end

local Highlight = {}

function Highlight.isClientOwned(part)
    if not part then return false end
    if part == State.CurrentPart then return true end
    local ok, age = pcall(function()
        return part.ReceiveAge
    end)
    if ok and age then
        return age < 0.1
    end
    return false
end

function Highlight.create(part)
    if not part or not part.Parent then return nil end
    if State.CurrentHighlight and State.CurrentHighlight.Parent then
        State.CurrentHighlight:Destroy()
    end
    local hl = Instance.new("Highlight")
    hl.Name = "PartControlHighlight"
    hl.Adornee = part
    hl.FillTransparency = CONFIG.FILL_TRANSPARENCY
    hl.OutlineTransparency = CONFIG.OUTLINE_TRANSPARENCY
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = part
    State.CurrentHighlight = hl
    return hl
end

function Highlight.update(part)
    if not part or not part.Parent then return end
    if not State.CurrentHighlight or not State.CurrentHighlight.Parent then
        Highlight.create(part)
        return
    end
    if Highlight.isClientOwned(part) then
        State.CurrentHighlight.FillColor = CONFIG.COLOR_OWNED
        State.CurrentHighlight.OutlineColor = CONFIG.COLOR_OWNED
    else
        State.CurrentHighlight.FillColor = CONFIG.COLOR_NOT_OWNED
        State.CurrentHighlight.OutlineColor = CONFIG.COLOR_NOT_OWNED
    end
end

function Highlight.destroy()
    if State.CurrentHighlight and State.CurrentHighlight.Parent then
        State.CurrentHighlight:Destroy()
    end
    State.CurrentHighlight = nil
end

