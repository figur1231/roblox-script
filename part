local Weld = {}

function Weld.attach(rootPart, targetPart)
    if not rootPart or not targetPart then return nil end
    if not rootPart.Parent or not targetPart.Parent then return nil end
    Weld.detach()
    local weld = Instance.new("Weld")
    weld.Name = "PartControlWeld"
    weld.Part0 = rootPart
    weld.Part1 = targetPart
    weld.C0 = rootPart.CFrame:ToObjectSpace(targetPart.CFrame)
    weld.C1 = CFrame.new()
    weld.Parent = rootPart
    State.CurrentWeld = weld
    return weld
end

function Weld.detach()
    if State.CurrentWeld and State.CurrentWeld.Parent then
        State.CurrentWeld:Destroy()
    end
    State.CurrentWeld = nil
end

local Core = {}

function Core.becomePart(part)
    if not Utils.isPartValid(part) then
        Logger.warn("Парт невалиден или заанкорен")
        return false
    end
    if Utils.isPartOfCharacter(part) then
        Logger.warn("Нельзя стать частью своего персонажа")
        return false
    end
    if part == State.CurrentPart then
        Logger.info("Уже управляете этим партом")
        return false
    end
    
    Core.release()
    
    State.CurrentPart = part
    History.add(part)
    State.Stats.Captures = State.Stats.Captures + 1
    
    Highlight.create(part)
    Highlight.update(part)
    OwnerView.create(part)
    OwnerView.update(part)
    
    local rootPart = Utils.getRootPart()
    if not rootPart then
        Logger.error("Не найден HumanoidRootPart")
        return false
    end
    
    Weld.attach(rootPart, part)
    
    State.HeartbeatConnection = RunService.Heartbeat:Connect(function()
        local now = tick()
        if now - State.LastHeartbeatUpdate < CONFIG.HEARTBEAT_UPDATE_RATE then
            return
        end
        State.LastHeartbeatUpdate = now
        
        if State.CurrentPart and State.CurrentPart.Parent then
            Highlight.update(State.CurrentPart)
            OwnerView.update(State.CurrentPart)
            
            if State.Gui and State.Gui.InfoLabel then
                local root = Utils.getRootPart()
                if root then
                    local d = Utils.round(Utils.distance(root, State.CurrentPart), 1)
                    local owner = Utils.getOwnerName(State.CurrentPart)
                    State.Gui.InfoLabel.Text = string.format(
                        "Парт: %s | Дист: %s | Скор: %s | Владелец: %s",
                        State.CurrentPart.Name,
                        tostring(d),
                        tostring(Utils.round(State.CurrentPart.AssemblyLinearVelocity.Magnitude, 1)),
                        owner
                    )
                end
            end
        else
            Core.release()
        end
    end)
    
    State.CharacterConnection = LocalPlayer.CharacterAdded:Connect(function(newCharacter)
        if State.CurrentPart and State.CurrentPart.Parent then
            local newRoot = newCharacter:WaitForChild("HumanoidRootPart", 5)
            if newRoot then
                Weld.attach(newRoot, State.CurrentPart)
                Logger.info("Персонаж перепривязан после респавна")
            end
        end
    end)
    
    if State.Gui and State.Gui.StatusLabel then
        State.Gui.StatusLabel.Text = "Статус: управляю " .. part.Name
        State.Gui.StatusLabel.TextColor3 = CONFIG.COLOR_OWNED
    end
    
    Logger.success("Теперь вы управляете партом: " .. part.Name)
    return true
end

function Core.release()
    if State.CharacterConnection then
        State.CharacterConnection:Disconnect()
        State.CharacterConnection = nil
    end
    if State.HeartbeatConnection then
        State.HeartbeatConnection:Disconnect()
        State.HeartbeatConnection = nil
    end
    Highlight.destroy()
    Weld.detach()
    OwnerView.destroy()
    if State.CurrentPart then
        Logger.info("Отпущен парт: " .. State.CurrentPart.Name)
        State.Stats.Releases = State.Stats.Releases + 1
    end
    State.CurrentPart = nil
    if State.Gui and State.Gui.StatusLabel then
        State.Gui.StatusLabel.Text = "Статус: свободен"
        State.Gui.StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end

function Core.teleportToPart()
    if not State.CurrentPart or not State.CurrentPart.Parent then
        Logger.warn("Нет активного парта")
        return
    end
    local root = Utils.getRootPart()
    if not root then return end
    local targetPos = State.CurrentPart.Position + Vector3.new(0, 5, 0)
    root.CFrame = CFrame.new(targetPos)
    Logger.info("Телепорт к парту")
end

function Core.autoCatch()
    local part = Utils.findNearestPart()
    if part then
        Core.becomePart(part)
    else
        Logger.warn("Ближайший парт не найден")
    end
end

function Core.showOwnerOfTarget()
    local target = Mouse.Target
    if not target or not target:IsA("BasePart") then
        Logger.warn("Наведите на парт")
        return
    end
    local owner = Utils.getOwnerName(target)
    local player = Utils.findPlayerWhoOwns(target)
    if player == LocalPlayer then
        Logger.success("Владелец " .. target.Name .. ": ВЫ (клиент)")
    elseif player then
        Logger.info("Владелец " .. target.Name .. ": " .. player.Name)
    else
        Logger.info("Владелец " .. target.Name .. ": Сервер")
    end
end

