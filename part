function Gui.refreshHistory()
    if not State.Gui or not State.Gui.HistoryFrame then return end
    for _, child in ipairs(State.Gui.HistoryFrame:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end
    for i, part in ipairs(State.History) do
        if part and part.Parent then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 22)
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
            btn.BorderSizePixel = 0
            btn.Text = string.format("%d. %s", i, part.Name)
            btn.TextColor3 = Color3.fromRGB(220, 220, 220)
            btn.TextSize = 12
            btn.Font = Enum.Font.Gotham
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.Parent = State.Gui.HistoryFrame
            local pad = Instance.new("UIPadding")
            pad.PaddingLeft = UDim.new(0, 6)
            pad.Parent = btn
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 4)
            corner.Parent = btn
            btn.MouseButton1Click:Connect(function()
                Core.becomePart(part)
                Gui.refreshHistory()
            end)
        end
    end
end

function Gui.toggle()
    if not State.Gui or not State.Gui.Main then return end
    State.GuiVisible = not State.GuiVisible
    State.Gui.Main.Visible = State.GuiVisible
end

function Gui.updateStats()
    if not State.Gui or not State.Gui.StatsLabel then return end
    State.Gui.StatsLabel.Text = string.format("Клики: %d | Захваты: %d | Отпуски: %d | Ошибки: %d",
        State.Stats.Clicks,
        State.Stats.Captures,
        State.Stats.Releases,
        State.Stats.Errors
    )
end

local Input = {}

function Input.setup()
    State.InputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == CONFIG.KEY_TOGGLE_GUI then
            Gui.toggle()
        elseif input.KeyCode == CONFIG.KEY_RELEASE then
            Core.release()
        elseif input.KeyCode == CONFIG.KEY_AUTO_CATCH then
            Core.autoCatch()
            Gui.refreshHistory()
        elseif input.KeyCode == CONFIG.KEY_TELEPORT then
            Core.teleportToPart()
        elseif input.KeyCode == Enum.KeyCode.O then
            Core.showOwnerOfTarget()
        end
    end)
end

function Input.setupClick()
    State.ClickConnection = Mouse.Button1Down:Connect(function()
        State.Stats.Clicks = State.Stats.Clicks + 1
        Gui.updateStats()
        local target = Mouse.Target
        if target and target:IsA("BasePart") then
            Core.becomePart(target)
            Gui.refreshHistory()
        end
    end)
end

local Init = {}

function Init.start()
    Logger.info("Запуск Part Control v2.1")
    Logger.info("Клавиши: Ctrl — GUI, R — отпустить, F — автозахват, T — телепорт, O — владелец")
    Gui.build()
    Gui.updateStats()
    Input.setup()
    Input.setupClick()
    Logger.success("Скрипт загружен")
end

function Init.stop()
    Logger.info("Остановка")
    Core.release()
    if State.InputConnection then State.InputConnection:Disconnect() end
    if State.ClickConnection then State.ClickConnection:Disconnect() end
    if State.Gui and State.Gui.ScreenGui then State.Gui.ScreenGui:Destroy() end
    State.Gui = nil
end

Init.start()

return Init.stop
